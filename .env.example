# ===========================================
# e-Learning Platform 環境変数設定
# ===========================================
# このファイルを .env.local にコピーして使用してください
# cp .env.example .env.local

# -------------------------------------------
# Clerk Authentication
# https://dashboard.clerk.com で取得
# -------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxx
CLERK_SECRET_KEY=sk_test_xxxxx

# Clerk Webhook (オプション - ユーザー同期用)
CLERK_WEBHOOK_SECRET=whsec_xxxxx

# -------------------------------------------
# Cloudflare D1 Database
# Wrangler CLI で作成: wrangler d1 create elearning-dev
# -------------------------------------------
CLOUDFLARE_ACCOUNT_ID=your_account_id
CLOUDFLARE_D1_DATABASE_ID=your_database_id
CLOUDFLARE_API_TOKEN=your_api_token

# -------------------------------------------
# Cloudflare R2 Storage (動画・ファイル保存用)
# -------------------------------------------
R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_access_key
R2_SECRET_ACCESS_KEY=your_secret_key
R2_BUCKET_NAME=elearning-videos
R2_PUBLIC_URL=https://your-bucket.r2.cloudflarestorage.com

# -------------------------------------------
# Stripe Payment (Phase 4 で使用)
# https://dashboard.stripe.com で取得
# -------------------------------------------
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxx
STRIPE_SECRET_KEY=sk_test_xxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxx

# -------------------------------------------
# API Configuration
# -------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8787
API_SECRET_KEY=your_secure_random_key

# -------------------------------------------
# App Configuration
# -------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001
NODE_ENV=development
